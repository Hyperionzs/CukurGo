DB_HOST="YOUR_DB_HOST"
DB_NAME="YOUR_DB_NAME"
DB_USER="YOUR_DB_USER"
DB_PASS="YOUR_DB_PASS"

# Admin panel (/public/admin/) — buat hash password, gunakan command ini di terminal: php -r "echo password_hash('password_anda', PASSWORD_DEFAULT);"
ADMIN_PASSWORD_HASH=""

# Optional: batasi IP (koma), untuk memastikan admin hanya bisa mengakses admin panel dari IP/jaringan tertentu
ADMIN_ALLOWED_IPS="" # contoh: 127.0.0.1,192.168.1.10

# Optional: lapisan Basic Auth tambahan (user + plain password), autentikasi sebelum menampilkan halaman admin login
ADMIN_BASIC_USER=""
ADMIN_BASIC_PASS=""

# Jendela booking (format HH:MM, zona Asia/Jakarta)
BOOKING_OPEN_TIME="08:00"
BOOKING_CLOSE_TIME="20:00"
BOOKING_MAX_DAYS_AHEAD="90"